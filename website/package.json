{
  "name": "kacha-official-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "build:pages": "GITHUB_PAGES_BASE_PATH=/kacha WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build && GITHUB_PAGES_BASE_PATH=/kacha node scripts/package-github-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1",
    "test": "node --test tests/build-glob.test.mjs && npm run build && node --test tests/rendered-html.test.mjs",
    "test:pages": "node --test tests/build-glob.test.mjs && npm run build:pages && node --test tests/github-pages.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "lint": "oxlint . --deny-warnings --ignore-pattern dist --ignore-pattern .next --ignore-pattern .open-next",
    "typecheck": "node node_modules/typescript/bin/tsc --project tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "oxlint": "1.88.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.2.0",
    "vite": "8.3.4",
    "wrangler": "4.151.0",
    "fast-glob": "file:build/glob-adapter"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30",
      "styled-jsx": "5.1.7"
    },
    "fast-glob": "$fast-glob",
    "sharp": "0.35.5",
    "fflate": "0.8.3",
    "ws": "8.22.0",
    "@cspotcode/source-map-support": {
      "@jridgewell/trace-mapping": "0.3.31"
    },
    "@tailwindcss/node": {
      "lightningcss": "1.33.0"
    }
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "fsevents": false
  }
}
