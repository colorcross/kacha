{
  "name": "kacha-official-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js build",
    "build:pages": "GITHUB_PAGES_BASE_PATH=/kacha WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js build --prerender-all && GITHUB_PAGES_BASE_PATH=/kacha node scripts/package-github-pages.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js start",
    "test": "node --test tests/build-glob.test.mjs && npm run build && node --test tests/rendered-html.test.mjs",
    "test:pages": "node --test tests/build-glob.test.mjs && npm run build:pages && node --test tests/github-pages.test.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "lint": "oxlint . --deny-warnings --ignore-pattern dist --ignore-pattern .next --ignore-pattern .open-next",
    "typecheck": "node node_modules/typescript/bin/tsc --project tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxlint": "1.76.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.1.5",
    "wrangler": "4.147.0",
    "fast-glob": "file:build/glob-adapter"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.4"
    },
    "fast-glob": "$fast-glob"
  },
  "type": "module"
}
