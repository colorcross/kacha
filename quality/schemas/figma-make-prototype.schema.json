{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "appcreate://schemas/figma-make-prototype.schema.json",
  "title": "AppCreate Figma Make code prototype contract",
  "type": "object",
  "required": ["schemaVersion", "product", "productContracts", "applicability", "route", "design", "pages", "journeys", "promptPack", "prototype", "implementation", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"type": "object", "required": ["id", "name", "summary", "targetUsers", "platforms"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "summary": {"type": "string"}, "targetUsers": {"type": "array", "items": {"type": "string"}}, "platforms": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "productContracts": {"type": "object", "required": ["businessRules", "dataAndApi", "rolesAndPermissions", "failureBoundaries"], "properties": {"businessRules": {"type": "array", "items": {"type": "string"}}, "dataAndApi": {"type": "array", "items": {"type": "string"}}, "rolesAndPermissions": {"type": "array", "items": {"type": "string"}}, "failureBoundaries": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "applicability": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["undetermined", "applicable", "not_applicable"]}, "selectedBy": {"type": ["string", "null"]}, "selectedAt": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}, "approvedBy": {"type": ["string", "null"]}}, "additionalProperties": true},
    "route": {"type": "object", "required": ["loginState", "promptPackStatus", "action"], "properties": {"loginState": {"enum": ["authenticated", "unauthenticated", "unknown"]}, "promptPackStatus": {"enum": ["ready", "missing"]}, "action": {"enum": ["browser_automation", "prepare_prompt_pack", "prompt_pack_handoff"]}, "makeEntryUrl": {"type": "string"}, "decisionReason": {"type": "string"}, "observedAt": {"type": ["string", "null"]}}, "additionalProperties": true},
    "design": {"type": "object", "required": ["direction", "tokens", "responsiveModes", "accessibilityRequirements", "contentConstraints", "nonGoals"], "properties": {"direction": {"type": "string"}, "tokens": {"type": "array", "items": {"type": "string"}}, "responsiveModes": {"type": "array", "items": {"type": "string"}}, "accessibilityRequirements": {"type": "array", "items": {"type": "string"}}, "contentConstraints": {"type": "array", "items": {"type": "string"}}, "nonGoals": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "pages": {"type": "array", "items": {"type": "object", "required": ["id", "name", "route", "purpose", "states", "interactions", "acceptance"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "route": {"type": "string"}, "purpose": {"type": "string"}, "states": {"type": "array", "items": {"type": "object", "required": ["id", "description"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}}, "additionalProperties": true}}, "interactions": {"type": "array", "items": {"type": "object", "required": ["id", "trigger", "result"], "properties": {"id": {"type": "string"}, "trigger": {"type": "string"}, "result": {"type": "string"}, "targetPageId": {"type": ["string", "null"]}}, "additionalProperties": true}}, "acceptance": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "journeys": {"type": "array", "items": {"type": "object", "required": ["id", "name", "steps", "acceptance"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "steps": {"type": "array", "items": {"type": "object", "required": ["pageId", "interactionId", "action", "expected"], "properties": {"pageId": {"type": "string"}, "interactionId": {"type": "string"}, "action": {"type": "string"}, "expected": {"type": "string"}}, "additionalProperties": true}}, "acceptance": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "promptPack": {"type": "object", "required": ["sourceRefs", "sourceDocuments", "outputPath", "digest", "generatedAt"], "properties": {"sourceRefs": {"type": "array", "items": {"type": "string"}}, "sourceDocuments": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}, "additionalProperties": false}}, "outputPath": {"type": ["string", "null"]}, "digest": {"type": ["string", "null"]}, "generatedAt": {"type": ["string", "null"]}}, "additionalProperties": true},
    "prototype": {"type": "object", "required": ["makeRef", "producer", "codeRoot", "packageManifest", "lockfiles", "fileManifest", "treeDigest", "frozenAt", "run"], "properties": {"makeRef": {"type": ["string", "null"]}, "producer": {"type": ["string", "null"]}, "codeRoot": {"type": ["string", "null"]}, "packageManifest": {"type": ["string", "null"]}, "lockfiles": {"type": "array", "items": {"type": "string"}}, "fileManifest": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "sizeBytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "sizeBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}, "treeDigest": {"type": ["string", "null"]}, "frozenAt": {"type": ["string", "null"]}, "run": {"type": "object", "required": ["argv", "cwd", "baseUrl", "evidenceRef"], "properties": {"argv": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": ["string", "null"]}, "baseUrl": {"type": ["string", "null"]}, "evidenceRef": {"type": ["string", "null"]}}, "additionalProperties": true}}, "additionalProperties": true},
    "implementation": {"type": "object", "required": ["root", "sourceRevision", "fileManifest", "treeDigest", "frozenAt", "pageMappings", "journeyMappings", "verifiedAt"], "properties": {"root": {"type": ["string", "null"]}, "sourceRevision": {"type": ["string", "null"]}, "fileManifest": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "sizeBytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "sizeBytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}, "treeDigest": {"type": ["string", "null"]}, "frozenAt": {"type": ["string", "null"]}, "pageMappings": {"type": "array", "items": {"type": "object", "required": ["id", "status", "sourceRefs", "evidenceRefs"], "properties": {"id": {"type": "string"}, "status": {"enum": ["not_run", "passed", "failed", "partial"]}, "sourceRefs": {"type": "array", "items": {"type": "string"}}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}, "journeyMappings": {"type": "array", "items": {"type": "object", "required": ["id", "status", "sourceRefs", "evidenceRefs"], "properties": {"id": {"type": "string"}, "status": {"enum": ["not_run", "passed", "failed", "partial"]}, "sourceRefs": {"type": "array", "items": {"type": "string"}}, "evidenceRefs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}, "verifiedAt": {"type": ["string", "null"]}}, "additionalProperties": true},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "path", "sha256", "result", "subjectRefs", "producer", "observedAt"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string"}, "result": {"enum": ["passed", "failed", "partial", "not_run"]}, "subjectRefs": {"type": "array", "items": {"type": "string"}}, "producer": {"type": "string"}, "observedAt": {"type": "string", "format": "date-time"}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
