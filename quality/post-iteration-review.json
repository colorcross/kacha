    {"id":"R-002","domains":["code-architecture","code-implementation","security-privacy-compliance","test-quality"],"perspectives":["engineering","quality","security-privacy"],"levels":["artifact","component-module","system-data"],"severity":"high","status":"fixed_unverified","statement":"Caller-supplied registries could otherwise become command-execution injection surfaces.","rootCause":"Extensibility initially lacked separate read-only and executable trust boundaries.","impact":"Untrusted JSON could select arbitrary commands under the user account.","owner":"codex-primary","remediationRefs":["scripts/capability_broker.mjs","scripts/workflow_packs.mjs","tests/run_tests.mjs"],"regressionEvidenceRefs":["E-LOCAL"],"residualRisk":"Custom registries are now read-only; independent review remains open.","independentReviewer":null},
