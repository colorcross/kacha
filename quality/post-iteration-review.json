    {"id":"R-005","domains":["data-api","code-architecture","code-implementation","performance-reliability","test-quality"],"perspectives":["engineering","quality","sre-operations","data-analytics"],"levels":["artifact","component-module","system-data"],"severity":"high","status":"fixed_unverified","statement":"Media corpus build and validation could trust a stale media index or changed source file.","rootCause":"Stored source hashes were emitted but not revalidated across every build and validate boundary.","impact":"Search results could refer to obsolete ranges, license metadata or motion evidence.","owner":"codex-primary","remediationRefs":["scripts/media_corpus.mjs","tests/run_tests.mjs"],"regressionEvidenceRefs":["E-LOCAL"],"residualRisk":"Semantic retrieval remains keyword fallback until compatible vectors exist.","independentReviewer":null},
