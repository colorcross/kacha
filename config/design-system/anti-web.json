  "boundedSurfaceReasons": [
    "source_integrity",
    "dense_reading",
    "comparison_structure",
    "multi_item_progression",
    "privacy_boundary"
  ],
  "forbiddenPatterns": [
    "web_hero",
    "centered_modal",
    "sidebar_panel",
    "pill_navigation",
    "dashboard_grid",
    "browser_chrome_decoration",
    "uniform_three_card_row",
    "full_width_ui_bar",
    "card_wall",
    "card_to_card_transition"
  ],
  "globalRules": {
    "dialogueOrActionRemainsPrimaryClock": true,
    "realPictureBeforeGraphicContainer": true,
    "boundarylessBeforeBounded": true,
    "noAdjacentBoundedSurfaces": true,
    "compositionCooldownSeconds": 45,
    "maximumSingleBoundedSurfaceSeconds": 8,
    "maximumRoundedContainerAreaRatio": 0.34,
    "maximumSimultaneousReadingZones": 3,
    "minimumCleanReturnSecondsAfterBoundedSurface": 1.2,
    "sameMechanismMaximumShare": 0.35,
    "requireOneDominantMotionPerBeat": true,
    "requireNormalSpeedRepresentativePreview": true,
    "staticPeakFrameIsNotAcceptance": true
  },
  "showBudgets": {
    "tool-share": {
      "minimumRealPictureRatio": 0.68,
      "maximumBoundedSurfaceRatio": 0.22,
      "maximumDashboardRatio": 0,
      "minimumDistinctMechanismsPer120Seconds": 5
    },
    "book-talk": {
      "minimumRealPictureRatio": 0.72,
      "maximumBoundedSurfaceRatio": 0.16,
      "maximumDashboardRatio": 0,
