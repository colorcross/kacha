  "techniques": [
    {
      "id": "proof-reveal",
      "label": "先给问题，再让证据落地",
      "signals": [
        "evidence",
        "fact",
        "data",
        "test_result"
      ],
      "requiredEvidence": [
        "source_visible"
      ],
      "picture": "先交代测试条件，再展示可读结果，最后给有限定的判断",
      "audio": "读结果时降低配乐；数据字幕不加提示音",
      "templateIds": [
        "effect-semantic_evidence_insert",
        "caption-edge_annotation"
      ],
      "protectFromDecoration": true,
      "fallback": "保持原镜头与原始同期声；补齐证据后再选择手法",
      "review": [
        "正常速度检查语义、动作相位与声音连续性",
        "检查当前素材与画幅中的文字和人物安全区"
      ]
    },
    {
      "id": "demo-chain",
      "label": "输入—操作—反馈—结果",
      "signals": [
        "screen_demo",
        "operation"
      ],
      "requiredEvidence": [
        "input_visible",
        "operation_visible",
        "result_visible"
      ],
      "picture": "一次只放大一个操作区，保留鼠标起点和反馈；等待段可压缩但须标记",
      "audio": "真实点击只在发生时保留；不为每个字幕配音",
      "templateIds": [
        "effect-semantic_mask_emphasis",
        "effect-process_light_overlay"
      ],
      "protectFromDecoration": true,
      "fallback": "保持原镜头与原始同期声；补齐证据后再选择手法",
      "review": [
        "正常速度检查语义、动作相位与声音连续性",
        "检查当前素材与画幅中的文字和人物安全区"
      ]
    },
    {
