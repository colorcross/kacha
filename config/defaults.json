{
  "schemaVersion": "1.0",
  "editingDefaults": {
    "parameters": {
      "preserveSourceDimensions": true,
      "preserveSourceAspectRatio": true,
      "preserveEffectiveFrameRate": true,
      "subtitle": {
        "sourceOfTruth": "final_audio",
        "singleLine": true,
        "stayInsideFrame": true,
        "avoidPlatformUi": true
      },
      "audio": {
        "dialogueFirst": true,
        "keepResidualMuted": true,
        "profile": "warm-soft-long-listening",
        "targetIntegratedLufs": -21.0,
        "truePeakMaxDbtp": -4.0,
        "targetLoudnessRangeLu": {
          "min": 4.5,
          "max": 5.5
        },
        "bgm": {
          "targetBelowDialogueDb": 18.0,
          "stereoWidth": 0.5
        },
        "sfx": {
          "defaultBelowDialogueDb": 12.0,
          "highShelfFrequencyHz": 4500,
          "highShelfGainDb": -1.5
        }
      },
      "beauty": {
        "enabled": false,
        "engine": "beauty-v2",
        "profile": "natural"
      },
      "cleanup": {
        "automatic": false
      }
    },
    "instructions": [],
    "recipeParameters": {}
  },
  "style": {
    "system": "dahui-video-system",
    "profile": "xingzhe",
    "modes": {
      "show": "tool-share",
      "aspectRatio": "landscape-16x9",
      "language": "zh",
      "surface": "footage",
      "density": "standard"
    },
    "overrides": {}
  },
  "execution": {
    "modelTier": "balanced",
    "referenceTokenLimits": {
      "economy": 28000,
      "balanced": 56000,
      "frontier": 112000
    },
    "incremental": {
      "handleFrames": 25
    },
    "netstyle": {
      "automaticPlanning": true,
      "maximumPrimaryEffectsPer10Seconds": 2.5,
      "minimumGapSeconds": 0.35,
      "maximumConcurrentPrimaryEffects": 1,
      "representativeValidationCountPerEffect": 1,
      "renderCrf": 16
    },
    "visualBreathing": {
      "automaticPlanning": true,
      "maximumPrimaryEventsPer10Seconds": 1.5,
      "minimumGapSeconds": 1.2,
      "maximumMotionCoverageRatio": 0.55,
      "minimumStillCoverageRatio": 0.45,
      "renderCrf": 16
    },
    "spokenCaptions": {
      "automaticLayout": true,
      "defaultLayout": "plain_single",
      "maximumSimultaneousReadingZones": 3,
      "ordinarySubtitleSfx": "none",
      "renderCrf": 16
    },
    "fonts": {
      "autoDiscoverProjectFonts": true,
      "directories": ["Fonts", "fonts", "assets/fonts"],
      "allowRestrictedByDefault": false,
      "publicRedistribution": false,
      "routingProfile": "kacha-font-routing"
    },
    "visualEvidence": {
      "defaultMode": "fast",
      "maxFrames": {
        "fast": 8,
        "review": 16,
        "release": 16
      },
      "sceneThreshold": 0.34,
      "workers": 4,
      "maxImageEdge": 1280
    },
    "minimaxVision": {
      "maxFrames": 6,
      "hardMaxFrames": 12,
      "timeoutSeconds": 120,
      "maxImageBytes": 20971520,
      "networkMode": "direct_no_proxy"
    },
    "qualityControl": {
      "blackDurationSeconds": 0.08,
      "blackPixelThreshold": 0.1,
      "freezeNoiseDb": -60,
      "freezeDurationSeconds": 0.5,
      "silenceNoiseDb": -50,
      "silenceDurationSeconds": 0.5,
      "measurementTargetLufs": -20,
      "measurementTruePeakDbtp": -2,
      "measurementLoudnessRange": 7
    },
    "sourceSeparation": {
      "model": "htdemucs",
      "device": "auto",
      "maxDurationDiffSeconds": 0.04
    },
    "voiceEnhancement": {
      "preset": "warm-soft",
      "denoise": "light",
      "declick": false,
      "targetLufs": -21.0,
      "truePeakDbtp": -4.0,
      "channelMode": "preserve"
    },
    "stockMedia": {
      "defaultLimit": 3,
      "maximumLimit": 5,
      "searchTimeoutSeconds": 30,
      "downloadTimeoutSeconds": 90
    }
  },
  "tools": {
    "demucsBin": null,
    "sfxLibrary": null,
    "fontRegistry": null
  },
  "providers": {
    "minimax": {
      "credentialEnv": "MINIMAX_API_KEY",
      "region": "cn",
      "baseUrl": null
    },
    "pixabay": {
      "credentialEnv": "PIXABAY_API_KEY"
    },
    "pexels": {
      "credentialEnv": "PEXELS_API_KEY"
    }
  }
}
