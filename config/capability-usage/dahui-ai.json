{
  "schemaVersion": "1.0",
  "styleProfile": "dahui-ai",
  "profile": "evidence-led",
  "productionMotionPolicy": "../effects/production-motion-policy.json",
  "defaultShow": "ai-practice",
  "description": "按语义需求映射实际时间线，不设动效、蒙版和画中画配额。",
  "antiWebPolicy": "../design-system/anti-web.json",
  "minimumDurationSeconds": 45,
  "families": {
    "opening": {
      "minimumPerVideo": 0,
      "minimumPerMinute": 0,
      "maximumPerMinute": 0.25
    },
    "expressive_transition": {
      "minimumPerVideo": 0,
