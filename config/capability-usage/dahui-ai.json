    },
    "mask_depth": {
      "minimumPerVideo": 0,
      "minimumPerMinute": 0,
      "maximumPerMinute": 0.4
    },
    "semantic_motion": {
      "minimumPerVideo": 0,
      "minimumPerMinute": 0,
      "maximumPerMinute": 1.5
    },
    "gaze_guidance": {
      "minimumPerVideo": 0,
      "minimumPerMinute": 0,
      "maximumPerMinute": 0.65
    },
    "spatial_depth": {
      "minimumPerVideo": 0,
