{
  "schemaVersion": "2.0",
  "id": "kacha-font-routing",
  "scope": [
    "xingzhe-light-overlay",
    "xingzhe-spatial-lightpath",
    "xingzhe-humor-comic",
    "xingzhe-pixel-editorial"
  ],
  "principles": [
    "字体先按信息职责选择，再按情绪调整字号、颜色、字距和透明度",
    "常规口播字幕只用真实金陵体，不加底色、不加描边，固定使用 60% 阴影",
    "视频标题、术语定义、金句引用和大号题眼只用华光标题黑，允许受控透明渐变",
    "封面主标题只用封神榜书，封面其他文字只用细体",
    "辅助说明、来源、栏目、期号、系列和英文标识只用细体",
    "同一画面最多一个主展示字体和一个正文或字幕字体",
    "字体必须覆盖当前字符；缺字时不得静默回退，必须记录例外原因并通过预检"
  ],
  "allowedFamilies": [
    "方正粗金陵简体",
    "FZJinLS-B-GB",
    "青鸟华光标题黑体",
    "JBHGBTH",
    "Aa封神榜书",
    "AaFSBS",
    "思源黑体 CN Light",
    "Source Han Sans CN Light"
  ],
  "localAssets": {
    "subtitle_primary": {
      "path": "assets/private/fonts/FZCuJinLJW.ttf",
      "sha256": "3c15643db0ef339e1faf39b8b0c12ffead661565876e617fd25ca5209eabb1ea",
      "family": "方正粗金陵简体",
      "required": true,
      "private": true,
      "fallback": "forbidden"
    },
    "display_title": {
      "path": "assets/private/fonts/华光标题黑.TTF",
      "sha256": "7446486b30fd433fb56ea7b745549f326218ea9161785deaf1a7df0ec8e124a0",
      "family": "青鸟华光标题黑体",
      "required": true,
      "private": true,
      "fallback": "forbidden"
    },
    "thin_support": {
      "path": "assets/private/fonts/细体-思源黑体7号.otf",
      "sha256": "317e53f4b71c757b9c2317354570f03dacae2321cbd6eb3f256c0b71c45610da",
      "family": "思源黑体 CN Light",
      "required": true,
      "private": true,
      "fallback": "forbidden"
    },
    "cover_title": {
      "path": "assets/private/fonts/封神榜书.ttf",
      "sha256": "4a2701607972a3b4804019b656800b7778deb6e1767093fc56a110eac48083ed",
      "family": "Aa封神榜书",
      "required": true,
      "private": true,
      "fallback": "forbidden"
    }
  },
  "roles": {
    "subtitle_primary": {
      "label": "常规口播字幕",
      "preferredFamilies": ["方正粗金陵简体", "FZJinLS-B-GB"],
      "targetWeight": 400,
      "maximumWeight": 400,
      "background": "none",
      "outline": "none",
      "shadowOpacity": 0.6,
      "soundPolicy": "none"
    },
    "subtitle_emphasis": {
      "label": "逻辑重音字幕",
      "preferredFamilies": ["方正粗金陵简体", "FZJinLS-B-GB"],
      "targetWeight": 400,
      "maximumWeight": 400,
      "background": "none",
      "outline": "none",
      "shadowOpacity": 0.6,
      "emphasisMethods": ["signal_color", "rational_color", "size_step", "underline", "word_spacing"],
      "soundPolicy": "only_visible_settle"
    },
    "display_title": {
      "label": "视频标题与大号题眼",
      "preferredFamilies": ["青鸟华光标题黑体", "JBHGBTH"],
      "targetWeight": 400,
      "maximumWeight": 400,
      "transparentGradient": true,
      "soundPolicy": "tonal_hit_or_none"
    },
    "term_definition": {
      "label": "术语定义",
      "preferredFamilies": ["青鸟华光标题黑体", "JBHGBTH"],
      "targetWeight": 400,
      "transparentGradient": true,
      "soundPolicy": "soft_tick_or_none"
    },
    "quote_pull": {
      "label": "金句引用",
      "preferredFamilies": ["青鸟华光标题黑体", "JBHGBTH"],
      "targetWeight": 400,
      "transparentGradient": true,
      "soundPolicy": "tonal_resolve_or_none"
    },
    "cover_title": {
      "label": "封面主标题",
      "preferredFamilies": ["Aa封神榜书", "AaFSBS"],
      "targetWeight": 400,
      "maximumWeight": 400,
      "soundPolicy": "none"
    },
    "thin_support": {
      "label": "辅助说明、标签、期号和封面其他文字",
      "preferredFamilies": ["思源黑体 CN Light", "Source Han Sans CN Light"],
      "targetWeight": 300,
      "maximumWeight": 300,
      "soundPolicy": "none"
    },
    "body_en": {
      "label": "英文正文兼容角色",
      "preferredFamilies": ["思源黑体 CN Light", "Source Han Sans CN Light"],
      "targetWeight": 300,
      "maximumWeight": 400,
      "soundPolicy": "none",
      "canonicalRole": "thin_support"
    },
    "caption_tech": {
      "label": "技术说明与图解标签兼容角色",
      "preferredFamilies": ["思源黑体 CN Light", "Source Han Sans CN Light"],
      "targetWeight": 300,
      "maximumWeight": 400,
      "soundPolicy": "soft_tick_or_none",
      "canonicalRole": "thin_support"
    },
    "caption_editorial": {
      "label": "编辑型口播字幕兼容角色",
      "preferredFamilies": ["方正粗金陵简体", "FZJinLS-B-GB"],
      "targetWeight": 400,
      "maximumWeight": 400,
      "background": "none",
      "outline": "none",
      "shadowOpacity": 0.6,
      "soundPolicy": "none",
      "canonicalRole": "subtitle_primary"
    },
    "display_title_zh": {
      "label": "中文展示标题兼容角色",
      "preferredFamilies": ["青鸟华光标题黑体", "JBHGBTH"],
      "targetWeight": 400,
      "maximumWeight": 400,
      "transparentGradient": true,
      "soundPolicy": "tonal_hit_or_none",
      "canonicalRole": "display_title"
    }
  },
  "exceptionPolicy": {
    "default": "forbid",
    "allowOnlyWhen": ["missing_glyph", "explicit_user_request", "source_artifact_requires_original_font"],
    "requireRecordedReason": true,
    "requireVisiblePreflightWarning": true,
    "forbidSilentFallback": true
  },
  "distributionPolicy": {
    "automaticSelectionStatuses": ["project_authorized"],
    "publicRedistributionRequiresExplicitLicense": true,
    "fontFilesRemainPrivateProjectAssets": true,
    "renderedOutputsMayBePublished": true,
    "projectAuthorizationScope": "video_production_and_published_outputs"
  }
}
