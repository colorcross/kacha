{
  "schemaVersion": "1.0",
  "id": "kacha-font-routing",
  "principles": [
    "字体先按信息功能选择，再按情绪气质选择，不能只因为好看就使用",
    "常规口播优先可长时间阅读的中性字体，装饰字体只用于短题眼、引语或明确的喜剧落点",
    "同一画面最多一个主展示字体和一个正文或字幕字体",
    "未知或限制性授权字体可以登记，但默认不进入自动选择，也不得随公开仓库分发",
    "字体选择必须覆盖当前文本字符，并在真实画幅和手机缩略尺寸下复核"
  ],
  "roles": {
    "subtitle_primary": {
      "label": "常规口播字幕",
      "scenes": ["plain_speech", "knowledge_explainer", "tool_demo"],
      "preferredFamilies": ["方正粗金陵简体", "FZJinLS-B-GB", "Source Han Sans CN", "思源黑体 CN", "PingFang SC"],
      "preferredClasses": ["editorial_serif", "neutral_sans"],
      "targetWeight": 400,
      "maximumWeight": 500,
      "allowDecorative": false,
      "soundPolicy": "none"
    },
    "subtitle_emphasis": {
      "label": "逻辑重音字幕",
      "scenes": ["conclusion", "contrast", "number", "turn"],
      "preferredFamilies": ["方正粗金陵简体", "FZJinLS-B-GB", "Source Han Sans CN", "思源黑体 CN", "Alegreya Sans"],
      "preferredClasses": ["editorial_serif", "display_sans", "neutral_sans"],
      "targetWeight": 400,
      "maximumWeight": 500,
      "allowDecorative": false,
      "soundPolicy": "only_visible_settle"
    },
    "caption_editorial": {
      "label": "编辑感短题眼",
      "scenes": ["chapter", "quote", "book_talk", "reflective"],
      "preferredFamilies": ["方正粗金陵简体", "FZJinLS-B-GB", "Source Han Sans CN"],
      "preferredClasses": ["editorial_serif", "neutral_sans"],
      "targetWeight": 700,
      "maximumWeight": 800,
      "allowDecorative": false,
      "soundPolicy": "soft_tick_or_none"
    },
    "caption_humor": {
      "label": "幽默或自嘲短句",
      "scenes": ["humor", "self_deprecation", "reaction"],
      "preferredFamilies": ["字由俏丽体", "仓耳恋爱笔记体", "Source Han Sans CN"],
      "preferredClasses": ["friendly_handwritten", "neutral_sans"],
      "targetWeight": 500,
      "maximumWeight": 700,
      "allowDecorative": true,
      "maximumCharacters": 12,
      "soundPolicy": "pop_or_click"
    },
    "caption_cultural": {
      "label": "传统文化或历史题眼",
      "scenes": ["history", "classics", "cultural_reference"],
      "preferredFamilies": ["励字隶书简繁", "造字侠今朝醉简", "Source Han Sans CN"],
      "preferredClasses": ["cultural_calligraphy", "editorial_serif", "neutral_sans"],
      "targetWeight": 600,
      "maximumWeight": 800,
      "allowDecorative": true,
      "maximumCharacters": 10,
      "soundPolicy": "page_or_low_tonal_hit"
    },
    "caption_tech": {
      "label": "工具、数据和流程",
      "scenes": ["tool_demo", "data", "workflow", "ai_dialogue"],
      "preferredFamilies": ["Source Han Sans CN", "Poppins", "Mina"],
      "preferredClasses": ["neutral_sans", "tech_sans"],
      "targetWeight": 500,
      "maximumWeight": 700,
      "allowDecorative": false,
      "soundPolicy": "ui_click_or_tick"
    },
    "display_title_zh": {
      "label": "中文标题和章节",
      "scenes": ["opening", "chapter", "cover"],
      "preferredFamilies": ["青鸟华光标题黑体", "优设标题黑", "Source Han Sans CN"],
      "preferredClasses": ["display_sans", "neutral_sans"],
      "targetWeight": 800,
      "maximumWeight": 900,
      "allowDecorative": false,
      "soundPolicy": "tonal_hit_or_none"
    },
    "display_title_en": {
      "label": "英文标题和章节",
      "scenes": ["opening", "chapter", "cover", "bilingual"],
      "preferredFamilies": ["Alegreya Sans", "Poppins", "Mina"],
      "preferredClasses": ["display_sans", "tech_sans", "neutral_sans"],
      "targetWeight": 900,
      "maximumWeight": 900,
      "allowDecorative": false,
      "soundPolicy": "tonal_hit_or_none"
    },
    "body_en": {
      "label": "英文正文与辅助字幕",
      "scenes": ["bilingual", "source", "definition"],
      "preferredFamilies": ["Poppins", "Mina", "Avenir Next"],
      "preferredClasses": ["tech_sans", "neutral_sans"],
      "targetWeight": 400,
      "maximumWeight": 600,
      "allowDecorative": false,
      "soundPolicy": "none"
    }
  },
  "classificationHints": {
    "neutral_sans": ["Source Han Sans", "思源黑体", "叙黑", "Poppins", "Mina"],
    "display_sans": ["标题黑", "畅黑", "烈黑", "战甲", "经典黑", "倔强黑", "Alegreya Sans Black"],
    "editorial_serif": ["金陵", "隶书", "Classical"],
    "friendly_handwritten": ["惊鸿", "俏丽", "恋爱", "新悦", "文乐", "温柔", "莫雪", "承英", "亦然"],
    "cultural_calligraphy": ["隶书", "封神", "今朝醉", "赤云隶", "Classical"],
    "fantasy_decorative": ["山海经", "战甲", "Starry", "Bless", "巴洛克", "封神"],
    "tech_sans": ["Poppins", "Mina", "Source Han Sans", "思源黑体"]
  },
  "distributionPolicy": {
    "openLicenseStatuses": ["open"],
    "automaticSelectionStatuses": ["open", "project_authorized"],
    "publicRedistributionRequiresExplicitLicense": true,
    "unknownLicenseDefault": "index_only"
  }
}
