  "runtimeRecipes": [
    {"id": "warm-paper-drift", "sourceAsset": "grain-overlay", "durationSeconds": 6, "motion": "scale 1.00→1.025; x -0.8%→0.8%; opacity 0.08", "loop": "ping_pong", "useWhen": "沉思、文化或章节背景需要轻微呼吸"},
    {"id": "graphite-grid-pulse", "sourceAsset": "warm-grid", "durationSeconds": 4, "motion": "opacity 0.08→0.16→0.08; scale 1.0→1.012", "loop": "ping_pong", "useWhen": "工具、数据、工作流与AI主题"},
    {"id": "amber-light-sweep", "sourceAsset": "light-sweep", "durationSeconds": 1.1, "motion": "x -80%→120%; opacity 0→0.5→0", "loop": "none", "useWhen": "揭示、页面切换或关键卡片落位"},
    {"id": "focus-ring-pulse", "sourceAsset": "focus-brackets", "durationSeconds": 0.5, "motion": "scale 1.06→1.0; opacity 0→1", "loop": "none", "useWhen": "点击、证据或局部焦点确认"},
    {"id": "directional-streak", "sourceAsset": "speed-lines", "durationSeconds": 0.42, "motion": "scaleX 0.8→1.05; opacity 0→0.7→0", "loop": "none", "useWhen": "短促方向运动或喜剧冲击"},
    {"id": "document-layer-drift", "sourceAsset": "nested-frames", "durationSeconds": 3.2, "motion": "front x 1.8%; middle x 0.9%; back x 0.25%", "loop": "none", "useWhen": "证据层级、来源对照或2.5D轻纵深"}
  ],
  "logicalSlots": [
    {"id": "real_evidence_image", "kind": "image", "selectionOrder": ["project_real_evidence", "official_source", "wikimedia_file_license_checked", "pexels_or_pixabay_project_copy", "generated_with_disclosure"], "fallback": "document-frame"},
    {"id": "real_evidence_video", "kind": "video", "selectionOrder": ["project_real_evidence", "official_source", "pexels_or_pixabay_project_copy", "generated_with_disclosure"], "fallback": "full_screen_insert_card"},
    {"id": "tool_screenshot", "kind": "image", "selectionOrder": ["project_capture", "official_product_media"], "fallback": "document-frame"},
    {"id": "person_cutout", "kind": "image_or_mask", "selectionOrder": ["project_subject_mask"], "fallback": "keep_a_roll"},
    {"id": "city_or_place", "kind": "image_or_video", "selectionOrder": ["official_source", "wikimedia_file_license_checked", "pexels_or_pixabay_project_copy"], "fallback": "source_card"},
    {"id": "texture", "kind": "image", "selectionOrder": ["bundled_original", "ambientcg_cc0_project_copy"], "fallback": "grain-overlay"},
    {"id": "icon", "kind": "svg", "selectionOrder": ["bundled_original", "tabler_mit_fetch_on_demand"], "fallback": "focus-brackets"},
    {"id": "background_motion", "kind": "runtime_recipe", "selectionOrder": ["runtime_original"], "fallback": "graphite-grid-pulse"}
  ],
  "providers": [
    {"id": "bundled_original", "mode": "bundled", "licensePolicy": "catalog_hash_and_declared_license_required"},
    {"id": "runtime_original", "mode": "render_at_runtime", "licensePolicy": "Kacha_original_recipe"},
    {"id": "project_real_evidence", "mode": "local_only", "licensePolicy": "project_record_required"},
    {"id": "project_capture", "mode": "local_only", "licensePolicy": "capture_source_and_project_authorization_required"},
    {"id": "project_subject_mask", "mode": "local_only", "licensePolicy": "subject_consent_and_frozen_source_hash_required"},
    {"id": "official_source", "mode": "fetch_on_demand", "licensePolicy": "source_terms_and_attribution_required"},
    {"id": "official_product_media", "mode": "fetch_on_demand", "licensePolicy": "official_media_terms_and_context_required"},
    {"id": "wikimedia_file_license_checked", "mode": "fetch_on_demand", "url": "https://commons.wikimedia.org/wiki/Commons:Reusing_content_outside_Wikimedia/en", "licensePolicy": "per_file_license_and_attribution_required"},
    {"id": "pexels_or_pixabay_project_copy", "mode": "fetch_on_demand", "adapter": "../../scripts/fetch_stock_media.py", "licenseUrls": ["https://www.pexels.com/license/", "https://pixabay.com/service/license-summary/"], "licensePolicy": "project_use_only_no_stock_redistribution"},
    {"id": "tabler_mit_fetch_on_demand", "mode": "fetch_on_demand", "url": "https://tabler.io/icons", "licensePolicy": "MIT_notice_required"},
    {"id": "ambientcg_cc0_project_copy", "mode": "fetch_on_demand", "url": "https://ambientcg.com/", "licensePolicy": "CC0_record_source_and_hash"},
    {"id": "generated_with_disclosure", "mode": "generate_on_demand", "licensePolicy": "provider_terms_reference_and_disclosure_decision_required"}
  ],
  "governance": {
    "noThirdPartyBinaryBundlingWithoutLicenseRecord": true,
    "projectPrivateCatalogMayExtendButNotOverrideCoreLicenses": true,
    "semanticMismatchMeansDoNotUse": true,
    "sourceUrlLicenseFormatAndShaRequiredForFetchedAssets": true,
    "fontsAndProjectPrivateSfxNeverEnterPublicBundle": true
  }
