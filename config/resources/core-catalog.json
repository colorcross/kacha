  "runtimeRecipes": [
    {"id": "warm-paper-drift", "sourceAsset": "grain-overlay", "durationSeconds": 6, "motion": "scale 1.00→1.025; x -0.8%→0.8%; opacity 0.08", "loop": "ping_pong", "useWhen": "沉思、文化或章节背景需要轻微呼吸"},
    {"id": "graphite-grid-pulse", "sourceAsset": "warm-grid", "durationSeconds": 4, "motion": "opacity 0.08→0.16→0.08; scale 1.0→1.012", "loop": "ping_pong", "useWhen": "工具、数据、工作流与AI主题"},
    {"id": "amber-light-sweep", "sourceAsset": "light-sweep", "durationSeconds": 1.1, "motion": "x -80%→120%; opacity 0→0.5→0", "loop": "none", "useWhen": "揭示、页面切换或关键卡片落位"},
    {"id": "focus-ring-pulse", "sourceAsset": "focus-brackets", "durationSeconds": 0.5, "motion": "scale 1.06→1.0; opacity 0→1", "loop": "none", "useWhen": "点击、证据或局部焦点确认"},
    {"id": "directional-streak", "sourceAsset": "speed-lines", "durationSeconds": 0.42, "motion": "scaleX 0.8→1.05; opacity 0→0.7→0", "loop": "none", "useWhen": "短促方向运动或喜剧冲击"},
    {"id": "document-layer-drift", "sourceAsset": "nested-frames", "durationSeconds": 3.2, "motion": "front x 1.8%; middle x 0.9%; back x 0.25%", "loop": "none", "useWhen": "证据层级、来源对照或2.5D轻纵深"},
    {"id": "editorial-margin-reveal", "sourceAsset": "editorial-margin-notes", "durationSeconds": 0.72, "motion": "edge rule 0%→100%; primary note opacity 0→1; support note delayed 5 frames", "loop": "none", "useWhen": "浅暖轻浮层在连续口播中建立一处边缘旁注"},
    {"id": "spatial-route-traverse", "sourceAsset": "spatial-route-field", "durationSeconds": 1.4, "motion": "path draw 0%→100%; focus moves only after path reaches node; destination settles", "loop": "none", "useWhen": "空间光路表达真实关系、因果或流程目的地"},
    {"id": "comic-beat-hold", "sourceAsset": "comic-beat-panels", "durationSeconds": 1.1, "motion": "setup hold 4 frames; reaction hard cut; punchline lands after half-beat", "loop": "none", "useWhen": "幽默漫画存在真实反差、反应或回扣"},
    {"id": "pixel-state-commit", "sourceAsset": "pixel-state-lattice", "durationSeconds": 0.6, "motion": "input→process→output in 3-frame integer steps; result fully static", "loop": "none", "useWhen": "像素风存在可核验的输入、状态变化与结果"},
    {"id": "diagnostic-evidence-lock", "sourceAsset": "diagnostic-aperture-grid", "durationSeconds": 1.15, "motion": "local isolation 8 frames; evidence aperture locks; verdict lands once; clean context restores", "loop": "none", "useWhen": "暗黑科技风存在异常、风险、冲突证据、隐性机制或真伪裁决"}
  ],
  "logicalSlots": [
