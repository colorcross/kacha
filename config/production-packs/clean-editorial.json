{
  "schemaVersion": "1.0",
  "id": "clean-editorial",
  "version": "1.1.0",
  "description": "无个人品牌依赖的通用口播、录屏和多素材剪辑生产包。",
  "base": {
    "cinematicPolicyFile": "clean-editorial.json",
    "typography": {
      "allowedFonts": [
        "PingFang SC",
        "Noto Sans CJK SC",
        "Source Han Sans SC",
        "Source Han Sans CN Medium",
        "Source Han Sans CN Light",
        "DejaVu Sans",
        "Arial"
      ],
      "regularSubtitle": {
        "font": "PingFang SC",
        "background": "none",
        "outline": "none",
        "shadowOpacity": 0.45
      },
      "displayFont": "Source Han Sans SC",
      "coverTitleFont": "Source Han Sans SC",
      "sequentialMultilineOnly": true
    },
    "cover": {
      "mode": "editorial_2d",
      "identityEvidenceRequired": true,
      "sceneSpecificPoseContractRequired": false,
      "poseReuseForbidden": false,
      "allowedGenerationInputModes": [
        "real_photo",
        "local_generated",
        "none"
      ],
      "requiredPoseFields": []
    },
    "firstMinute": {
      "windowSeconds": 60,
      "minimumMotivatedEffects": 0,
      "minimumDistinctMechanisms": 0,
      "minimumPeakAlignedSfx": 0,
      "maximumPrimaryEventsPer10Seconds": 2,
      "minimumHumanPresenceRatio": 0.7,
      "maximumFullScreenTakeoverRatio": 0.3,
      "minimumBreathingRoomRatio": 0.3,
      "minimumHumanReactionWindows": 0,
      "openingHookRequired": true,
      "audioVisualIntentMustMatch": true,
      "normalSpeedPreviewRequired": true
    },
    "editorialPolicy": "narrative-v1",
    "opening": {
      "firstVisibleChangeBySeconds": 3,
      "promiseBySeconds": 30
    }
  },
  "shows": {
    "talking-head": {
      "label": "通用口播",
      "editorialIntent": "保留完整表达，以内容、切点和字幕可读性决定剪辑。"
    },
    "screen-demo": {
      "label": "录屏演示",
      "editorialIntent": "按实际操作步骤剪辑，保持界面文字可读、结果和条件完整。",
      "firstMinute": {
        "minimumHumanPresenceRatio": 0,
        "maximumFullScreenTakeoverRatio": 1,
        "minimumHumanReactionWindows": 0
      }
    },
    "montage": {
      "label": "多素材剪辑",
      "editorialIntent": "按叙事与用户要求组织图片、视频和现场声，不要求出镜人物或对白。",
      "firstMinute": {
        "minimumHumanPresenceRatio": 0,
        "maximumFullScreenTakeoverRatio": 1,
        "minimumHumanReactionWindows": 0
      }
    }
  }
}
