{
  "schemaVersion": "1.0",
  "style": {
    "system": "dahui-video-system",
    "profile": "xingzhe",
    "modes": {
      "show": "tool-share",
      "aspectRatio": "landscape-16x9",
      "language": "zh",
      "surface": "footage",
      "density": "standard"
    },
    "overrides": {}
  },
  "editingDefaults": {
    "parameters": {
      "subtitle": {
        "singleLine": true,
        "safeAreaBottomRatio": 0.18
      },
      "audio": {
        "backgroundMusicRelativeDb": -24,
        "soundEffectRelativeDb": -14
      },
      "beauty": {
        "enabled": false,
        "engine": "beauty-v2",
        "profile": "natural"
      }
    },
    "instructions": [
      {
        "id": "calm-humorous-delivery",
        "text": "保留淡定、幽默、娓娓道来的表达，不要把所有自然停顿都剪掉。",
        "appliesTo": [
          "source_edit",
          "local_optimization"
        ],
        "modules": [
          "dialogue",
          "bgm",
          "sfx"
        ],
        "priority": "high"
      },
      "外加画面必须匹配当前视频的对象、动作、角色、时态和整体视觉风格。"
    ],
    "recipeParameters": {
      "beauty": {
        "profile": "natural",
        "temporalConsistency": "required"
      },
      "subtitles": {
        "singleLine": true,
        "allowOverflow": false
      },
      "visual_breathing": {
        "maximumMotionCoverageRatio": 0.55,
        "minimumStillCoverageRatio": 0.45
      },
      "caption_layout": {
        "defaultLayout": "plain_single",
        "maximumSimultaneousReadingZones": 3
      }
    }
  },
  "execution": {
    "modelTier": "balanced",
    "incremental": {
      "handleFrames": 30
    },
    "netstyle": {
      "automaticPlanning": true,
      "maximumPrimaryEffectsPer10Seconds": 2.5,
      "minimumGapSeconds": 0.35,
      "maximumConcurrentPrimaryEffects": 1,
      "representativeValidationCountPerEffect": 1,
      "renderCrf": 16
    },
    "visualEvidence": {
      "maxFrames": {
        "review": 18
      }
    }
  }
}
